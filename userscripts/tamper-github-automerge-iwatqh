// ==UserScript==
// @name         GitHub Codex PR Auto-Merger - IWAtQH
// @namespace    mason.github.codex.automerge.simple
// @version      2.0.0
// @description  Finds Codex-labeled PRs from the PR list, opens them, then clicks Merge pull request and Confirm merge with no further checks.
// @match        https://github.com/*/*/pulls*
// @match        https://github.com/*/*/pull/*
// @grant        none
// @run-at       document-idle
// ==/UserScript==

(() => {
  'use strict';

  /******************************************************************
   * FILL THESE IN
   ******************************************************************/

  const TARGET_OWNER = 'mscott1000';
  const TARGET_REPO = 'i-will-ask-the-questions-here';

  // The label text as it appears on the GitHub PR list.
  // Usually: "codex"
  const CODEX_LABEL_TEXT = 'codex';

  // How often the /pulls page refreshes when no Codex PR is found.
  const REFRESH_INTERVAL_MS = 30_000;

  // After confirming merge, go back to the pulls page after this delay.
  const RETURN_TO_LIST_AFTER_MERGE_MS = 8_000;

  /******************************************************************
   * BASIC HELPERS
   ******************************************************************/

  const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

  function log(...args) {
    console.log('[Codex Simple Auto-Merge]', ...args);
  }

  function cleanText(value) {
    return String(value || '')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function lowerText(value) {
    return cleanText(value).toLowerCase();
  }

  function currentRepoParts() {
    const parts = window.location.pathname.split('/').filter(Boolean);

    return {
      owner: parts[0] || '',
      repo: parts[1] || '',
      section: parts[2] || '',
      number: parts[3] || ''
    };
  }

  function isTargetRepo() {
    const { owner, repo } = currentRepoParts();

    return (
      lowerText(owner) === lowerText(TARGET_OWNER) &&
      lowerText(repo) === lowerText(TARGET_REPO)
    );
  }

  function isPullsListPage() {
    const { section } = currentRepoParts();
    return isTargetRepo() && section === 'pulls';
  }

  function isPullRequestPage() {
    const { section, number } = currentRepoParts();
    return isTargetRepo() && section === 'pull' && /^\d+$/.test(number);
  }

  function pullsListUrl() {
    return `https://github.com/${TARGET_OWNER}/${TARGET_REPO}/pulls`;
  }

  function absoluteUrl(href) {
    return new URL(href, window.location.origin).href;
  }

  function isVisible(el) {
    if (!el) return false;

    const rect = el.getBoundingClientRect();
    const style = window.getComputedStyle(el);

    return (
      rect.width > 0 &&
      rect.height > 0 &&
      style.display !== 'none' &&
      style.visibility !== 'hidden'
    );
  }

  async function waitFor(fn, timeoutMs = 60_000, intervalMs = 300) {
    const start = Date.now();

    while (Date.now() - start < timeoutMs) {
      const result = fn();

      if (result) return result;

      await sleep(intervalMs);
    }

    return null;
  }

  function clickHard(el, label) {
    if (!el) return false;

    log(`Clicking ${label}:`, el);

    el.scrollIntoView({
      behavior: 'smooth',
      block: 'center',
      inline: 'center'
    });

    el.focus?.();

    el.dispatchEvent(new MouseEvent('mouseover', {
      bubbles: true,
      cancelable: true,
      view: window
    }));

    el.dispatchEvent(new MouseEvent('mousedown', {
      bubbles: true,
      cancelable: true,
      view: window
    }));

    el.dispatchEvent(new MouseEvent('mouseup', {
      bubbles: true,
      cancelable: true,
      view: window
    }));

    el.click();

    return true;
  }

  /******************************************************************
   * LIST PAGE: FIND CODEX PR
   ******************************************************************/

  function rowHasCodexLabel(row) {
    const wanted = lowerText(CODEX_LABEL_TEXT);

    const possibleLabelNodes = [
      ...row.querySelectorAll('.IssueLabel'),
      ...row.querySelectorAll('[data-name]'),
      ...row.querySelectorAll('[aria-label]'),
      ...row.querySelectorAll('[title]'),
      ...row.querySelectorAll('a[href*="/labels/"]'),
      ...row.querySelectorAll('span')
    ];

    return possibleLabelNodes.some(node => {
      const values = [
        node.textContent,
        node.getAttribute('data-name'),
        node.getAttribute('aria-label'),
        node.getAttribute('title'),
        node.getAttribute('href')
      ];

      return values.some(value => {
        const text = lowerText(value);
        return text === wanted || text.includes(wanted);
      });
    });
  }

  function findCodexPrOnPullsList() {
    const rows = [
      ...document.querySelectorAll('.js-issue-row'),
      ...document.querySelectorAll('.Box-row'),
      ...document.querySelectorAll('[id^="issue_"]')
    ];

    const uniqueRows = [...new Set(rows)];

    for (const row of uniqueRows) {
      if (!rowHasCodexLabel(row)) continue;

      const link =
        row.querySelector(`a[href^="/${TARGET_OWNER}/${TARGET_REPO}/pull/"]`) ||
        row.querySelector('a[href*="/pull/"].js-navigation-open') ||
        row.querySelector('a[href*="/pull/"]');

      if (!link) continue;

      return {
        row,
        link,
        url: absoluteUrl(link.getAttribute('href'))
      };
    }

    return null;
  }

  async function handlePullsListPage() {
    log('On PR list page.');

    await sleep(1_000);

    const match = findCodexPrOnPullsList();

    if (match) {
      log('Found Codex PR. Opening:', match.url);
      window.location.href = match.url;
      return;
    }

    log(`No Codex PR found. Refreshing in ${REFRESH_INTERVAL_MS / 1000} seconds.`);

    setTimeout(() => {
      if (isPullsListPage()) {
        window.location.reload();
      }
    }, REFRESH_INTERVAL_MS);
  }

  /******************************************************************
   * PR PAGE: NO GUARDRAILS, JUST CLICK MERGE THEN CONFIRM
   ******************************************************************/

  function getClickableAncestor(el) {
    if (!el) return null;

    return (
      el.closest('button') ||
      el.closest('[role="button"]') ||
      el.closest('summary') ||
      el.closest('input[type="submit"]') ||
      el
    );
  }

  function findButtonByExactText(buttonText) {
    const wanted = lowerText(buttonText);

    /*
     * This specifically catches GitHub's current Primer button label:
     *
     * <span data-component="text" class="prc-Button-Label-FWkx3">
     *   Merge pull request
     * </span>
     */
    const primerTextSpans = [
      ...document.querySelectorAll('span[data-component="text"]')
    ];

    for (const span of primerTextSpans) {
      if (!isVisible(span)) continue;

      if (lowerText(span.textContent) === wanted) {
        return getClickableAncestor(span);
      }
    }

    /*
     * Fallback: search every normal clickable element by visible text.
     */
    const clickables = [
      ...document.querySelectorAll('button'),
      ...document.querySelectorAll('[role="button"]'),
      ...document.querySelectorAll('summary'),
      ...document.querySelectorAll('input[type="submit"]')
    ];

    for (const el of clickables) {
      if (!isVisible(el)) continue;

      const text = lowerText(
        el.innerText ||
        el.textContent ||
        el.value ||
        el.getAttribute('aria-label') ||
        ''
      );

      if (text === wanted || text.includes(wanted)) {
        return el;
      }
    }

    return null;
  }

  function findMergePullRequestButton() {
    return findButtonByExactText('Merge pull request');
  }

  function findConfirmMergeButton() {
    return (
      findButtonByExactText('Confirm merge') ||
      findButtonByExactText('Confirm merge pull request')
    );
  }

  async function handlePullRequestPage() {
    log('On PR page. No Codex re-check. No mergeability check. Looking only for buttons.');

    await sleep(1_500);

    const mergeButton = await waitFor(findMergePullRequestButton, 60_000, 300);

    if (!mergeButton) {
      log('FAILED: Could not find "Merge pull request" button.');
      return;
    }

    clickHard(mergeButton, 'Merge pull request');

    await sleep(1_000);

    const confirmButton = await waitFor(findConfirmMergeButton, 60_000, 300);

    if (!confirmButton) {
      log('FAILED: Could not find "Confirm merge" button.');
      return;
    }

    clickHard(confirmButton, 'Confirm merge');

    log('Clicked Confirm merge. Returning to PR list soon.');

    setTimeout(() => {
      window.location.href = pullsListUrl();
    }, RETURN_TO_LIST_AFTER_MERGE_MS);
  }

  /******************************************************************
   * ENTRYPOINT
   ******************************************************************/

  async function main() {
    if (!isTargetRepo()) return;

    if (isPullsListPage()) {
      await handlePullsListPage();
      return;
    }

    if (isPullRequestPage()) {
      await handlePullRequestPage();
      return;
    }
  }

  main().catch(err => {
    console.error('[Codex Simple Auto-Merge] Fatal error:', err);
  });

})();
